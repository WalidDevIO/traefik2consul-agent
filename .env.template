# ── Core ──────────────────────────────────────────────────
CONSUL_ADDR=http://consul:8500          # Consul HTTP API address (Default: http://consul:8500)
MODE=cluster                            # Operating mode: "cluster", "kv", or "tags" (Default: cluster)

# ── Cluster mode ──────────────────────────────────────────
CLUSTER_NAME=aggregator                 # Name prefix for services in Consul (Default: aggregator / hostname in kv/tags)
API_PORT=8099                           # Port for the dashboard + REST API (Default: 8099)
DISABLE_UI=false                        # Set to true to disable the web dashboard, API only (Default: false)

# ── Sync ──────────────────────────────────────────────────
RESYNC_SECONDS=30                       # Interval between full resyncs (Default: 30)
HC_INTERVAL=10s                         # Health check + session renew interval (Default: 10s)
HC_TIMEOUT=5s                           # Health check timeout (Default: 5s)
HC_DEREGISTER_AFTER=30s                 # Deregister timeout + session TTL (Default: 30s)
DEBUG=false                             # Write debug logs to debug.log (Default: false)

# ── Instances (choose one) ────────────────────────────────
# Option A: single instance (legacy, for kv/tags mode)
# TRAEFIK_URL=http://traefik:8080
# TRAEFIK_HOST=
# SERVICE=http://192.168.1.1:80

# Option B: multiple instances (JSON, works in all modes)
# TRAEFIK_INSTANCES=[{"name":"site-a","url":"http://traefik-a:8080","service":"http://192.168.1.10:80"},{"name":"site-b","url":"http://traefik-b:8080"}]

# In cluster mode, instances can also be added/removed via the dashboard at runtime.
